# Pulser Configuration
# Copy to .env and fill in values.

# Optional: LLM API key (for search term generation + RAG answers)
# Supports OpenAI-compatible APIs (NVIDIA NIM, OpenAI, Ollama, etc.)
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-70b-instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Scraping
MAX_CONCURRENT_REQUESTS=10
REQUEST_DELAY_MIN=0.4
REQUEST_DELAY_MAX=1.5
USER_AGENT_ROTATION=true

# Vector store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./output/chroma_db

# Output
OUTPUT_DIR=./output
LOG_LEVEL=INFO
